# LAN LT
ip a add 172.16.111.254/22 dev eth0
ip link set dev eth0 up

# Enlaces 
ip a add 192.168.100.86/30 dev eth1
ip link set dev eth1 up
ip a add 192.168.100.89/30 dev eth2
ip link set dev eth2 up

#Arrancar el OSPF
ulimit -n 1024
/etc/init.d/quagga start

#Arrancar el servidor DHCP para la red LT
/etc/init.d/isc-dhcp-server start
